# OfficeLand edge — FrankenPHP (Caddy) serving three distinct surfaces.
# See docs/ARCHITECTURE.md section 1.
#
#   /api/**     -> PHP (Laravel 12 + Octane worker mode)
#   /media/**   -> immutable content-addressed image derivatives
#   everything  -> prerendered static HTML (docs/DECISIONS.md D-009)

{
	frankenphp {
		worker {
			file /app/vendor/laravel/octane/bin/frankenphp-worker.php
			num {$OCTANE_WORKERS:4}
			# Octane's bootstrap resolves the application root from
			# APP_BASE_PATH in $_SERVER. Without it the worker exits 11
			# ("Cannot find application base path") before ever reaching
			# frankenphp_handle_request(), and FrankenPHP reports only a
			# generic worker-startup failure.
			env APP_BASE_PATH /app
		}
	}

	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	log {
		output stdout
		format json
	}

	encode zstd br gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# Clickjacking. frame-ancestors in the CSP below is the real control;
		# this covers browsers that predate it and costs one line.
		X-Frame-Options "DENY"

		-Server
	}

	# Content-Security-Policy, with script hashes derived from the prerendered
	# output (Phase 13a). GENERATED — see apps/web/tools/csp-hashes.mjs, and
	# the CI gate that fails when the build stops matching it.
	import /etc/caddy/csp.caddy

	# ---------------------------------------------------------------------
	# Staging guard (docs/SEO_SPEC.md section 8).
	# A staging leak into the index is self-inflicted and slow to undo, so
	# noindex is enforced at the edge, not left to application templates.
	# ---------------------------------------------------------------------
	@staging expression "{$APP_ENV:local}" != "production"
	header @staging X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		@nonprod expression "{$APP_ENV:local}" != "production"
		respond @nonprod "User-agent: *
Disallow: /
" 200

		root * /app/static
		file_server
	}

	# ---------------------------------------------------------------------
	# API — the only surface that executes PHP.
	# ---------------------------------------------------------------------
	handle /api/* {
		root * /app/public
		php_server
	}

	handle /health/* {
		root * /app/public
		php_server
	}

	# Admin panel (Filament, Phase 5).
	#
	# Filament's Alpine + Livewire runtime needs a looser CSP than the
	# storefront's hash-locked one: Alpine evaluates expressions (unsafe-eval)
	# and Livewire injects inline script. This policy is scoped to /admin, so the
	# storefront CSP the gates enforce is untouched. It is set INSIDE the handle
	# so it replaces the global storefront policy for this surface only.
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /app/public
		php_server
	}

	# Filament / Livewire assets and endpoints.
	#
	# These paths sit OUTSIDE /admin but are served by Laravel - its public dir
	# for the published CSS/JS, its routes for Livewire's script and update
	# endpoint and Filament's own routes. Without this they fall through to the
	# catch-all below, which serves the Angular static root, so the admin loads
	# unstyled (CSS 404s to the SPA shell) with a dead login form (Livewire's JS
	# never loads). Declared before the crawler and storefront handlers.
	handle /css/filament/* {
		root * /app/public
		file_server
	}
	handle /js/filament/* {
		root * /app/public
		file_server
	}
	handle /fonts/filament/* {
		root * /app/public
		file_server
	}
	# /livewire* not /livewire/*: Livewire randomises its route prefix
	# (/livewire-<hash>/livewire.js, /livewire-<hash>/update), so a prefix match
	# on "livewire" catches the script, the update endpoint and file uploads
	# whatever the hash is.
	handle /livewire* {
		root * /app/public
		php_server
	}
	handle /filament/* {
		root * /app/public
		php_server
	}

	# ---------------------------------------------------------------------
	# Media — content-addressed, therefore immutable (docs/ARCHITECTURE.md 8).
	# ---------------------------------------------------------------------
	# handle_path, NOT handle: handle_path strips the matched prefix, handle
	# does not. With `handle` Caddy resolved /media/ab/cd/<sha>/pdp-800.jpeg
	# against /app/storage-media/media/ab/cd/... — a path that never exists —
	# and every image 404'd while the files sat correctly on disk. The store is
	# addressed by checksum from the media root, so the /media prefix is a URL
	# namespace only and must not reach the filesystem.
	handle_path /media/* {
		root * /app/storage-media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Legacy redirects (D-007). GENERATED from the redirects table by
	# `php artisan redirects:publish`. Declared BEFORE the static handler so a
	# legacy URL never has a chance to resolve to a file or fall through to the
	# 404 -- a redirect that fires after the 404 is not a redirect.
	import /etc/caddy/redirects.caddy

	# ---------------------------------------------------------------------
	# Dynamic Rendering (docs/DECISIONS.md D-009, revised).
	#
	# The storefront is a client-rendered SPA. Crawlers and social scrapers do
	# not run JavaScript, so an empty shell would be all they ever saw. They
	# are matched by user-agent and routed to the Angular server engine
	# (render:4000), which renders the SAME route to complete HTML on demand -
	# title, meta, canonical and JSON-LD already written into the head by
	# SeoService. Humans never reach this; they fall through to the SPA below.
	#
	# The path exclusions keep a bot's request for an asset, the API, /media,
	# /admin or a health probe on its own fast path rather than booting a
	# render for a file that has nothing to render.
	# ---------------------------------------------------------------------
	@crawler {
		header_regexp User-Agent "(?i)(googlebot|google-inspectiontool|storebot-google|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|facebookexternalhit|facebot|twitterbot|linkedinbot|embedly|quora-link-preview|pinterestbot|slackbot|slack-imgproxy|vkshare|w3c_validator|whatsapp|telegrambot|discordbot|applebot|petalbot|bytespider|redditbot|rogerbot|screaming-?frog|semrushbot|ahrefsbot|mj12bot|dotbot|skypeuripreview|nuzzel|flipboard|bitlybot)"
		not path *.js *.mjs *.css *.map *.json *.xml *.txt *.ico *.png *.jpg *.jpeg *.webp *.avif *.gif *.svg *.woff *.woff2 *.ttf
	}
	handle @crawler {
		reverse_proxy render:4000
	}

	# ---------------------------------------------------------------------
	# The storefront. SSR for everyone, hydrated in the browser.
	#
	# Humans used to get an empty CSR shell and render the whole page client-
	# side: every async section re-fetched and swapped a skeleton for content
	# of a different height (0.72 mobile CLS), and nothing meaningful painted
	# until the bundle booted and the data returned (slow LCP). Now a human
	# navigation is rendered on the server (render:4000) exactly as a crawler's
	# is, and `provideClientHydration` makes the browser REUSE that DOM instead
	# of rebuilding it - so there is no skeleton swap and the content is in the
	# first paint.
	#
	# Assets still come straight off disk; only extensionless app routes reach
	# the renderer.
	# ---------------------------------------------------------------------
	handle {
		root * /app/static

		# A path with a file extension is an asset: a hashed bundle, a font or
		# image, a sitemap (.xml), a favicon, or the CSR shell. Serve it off
		# disk. An Angular route has NO extension and keeps its trailing slash,
		# so it never matches here and falls through to the renderer below - the
		# split that lets humans be server-rendered without routing every static
		# file through Node. (The `file` matcher is avoided on purpose: it also
		# matches the root directory, which would serve the shell for `/`.)
		@asset path_regexp \.[A-Za-z0-9]+$
		handle @asset {
			# Content-hashed bundles never change: far-future immutable cache.
			# Angular emits `name-U44D4EQK.js` (dash, uppercase base32); the
			# media pipeline emits lowercase hex. Match both.
			@hashed path_regexp [.-]([A-Z0-9]{8,}|[a-f0-9]{8,})\.(js|mjs|css|woff2|png|jpg|jpeg|webp|avif|svg|ico)$
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Every remaining path is an app route, now server-rendered for humans.
		#
		# The HTML is identical for every anonymous visitor (the quote basket is
		# client-side, there is no login on the storefront), so it is marked
		# edge-cacheable: Cloudflare serves the hot pages from cache and the
		# render service only ever renders a cold URL once, then refreshes it in
		# the background. That cache is load-bearing here - without it this
		# handler would send every human request to a single Node process.
		# s-maxage is the shared-cache (CDN) TTL; browsers get max-age=0 and
		# always revalidate, so a redeploy is picked up on the next view.
		# stale-if-error lets Cloudflare keep serving the last good render of a
		# hot page if the render service is briefly down, so an origin hiccup
		# degrades to a slightly stale page rather than a 502.
		handle {
			header Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400"
			reverse_proxy render:4000
		}
	}
}
