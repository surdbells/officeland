# Deliberately gone (410), not missing (404). A 410 is dropped from
# the index faster and does not keep being re-crawled.
#
# Wrapped in `handle`, not a bare `respond`. Caddy evaluates directives
# in a fixed order in which `respond` comes AFTER `handle`, so a bare
# respond loses to the static handler and the URL 404s instead —
# which is exactly what it did. Inside a handle it joins the same
# mutually-exclusive group and wins by appearing first.
@ol_gone path "/cart-2/" "/cart/" "/checkout/" "/feed/" "/my-account-2/" "/my-account/" "/product-category/uncategorized/" "/wp-admin/" "/wp-login.php"
handle @ol_gone {
	respond 410
}
