# OfficeLand — local development defaults.
# Copy to .env. Never commit .env (see .gitignore).
# Secret rotation procedure: docs/RUNBOOK.md.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8095

HTTP_PORT=8095

# Octane worker count. Production value is derived from the server core count
# and must match the PgBouncer arithmetic in infra/pgbouncer/pgbouncer.ini.
# Blocked on open question Q7 (server specification).
OCTANE_WORKERS=4

# --- Database ---------------------------------------------------------------
# The application connects through PgBouncer (transaction pooling).
# Migrations connect DIRECT; see docs/ARCHITECTURE.md section 5.
DB_CONNECTION=pgsql
DB_DATABASE=officeland
DB_USERNAME=officeland
DB_PASSWORD=secret
DB_POOLED_PORT=6432
DB_DIRECT_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Storefront build -------------------------------------------------------
# 1 = rebuild on file change. Off by default; a full build is expensive and
# Phase 8 replaces this with incremental rendering.
RENDER_WATCH=0

# --- Build target -----------------------------------------------------------
# dev | prod
BUILD_TARGET=dev

# --- Icecat (Phase 5b) ------------------------------------------------------
# Access is IP-whitelisted, or authenticated with dynamic tokens where the
# egress IP is not stable. Non-whitelisted requests return 404, not 403.
# Tier is open question Q-A. Credentials are entered by the client on their
# own server and never shared with the development team.
ICECAT_USERNAME=
ICECAT_PASSWORD=
ICECAT_ACCESS_LEVEL=freexml
ICECAT_LANG=en
ICECAT_MAX_CONNECTIONS=50

# --- ZeptoMail (Phase 10) ---------------------------------------------------
# SMTP is explicitly forbidden. HTTP API only.
# Region (.com vs .eu) is open question Q18.
MAIL_MAILER=zeptomail
ZEPTOMAIL_ENDPOINT=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=
MAIL_FROM_ADDRESS=sales@officelandng.com
MAIL_FROM_NAME="OfficeLand Nigeria"

# Quote routing. Editable in admin; these are the bootstrap defaults.
QUOTE_DEFAULT_RECIPIENTS=sales@officelandng.com
