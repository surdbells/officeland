/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    /* MASTER BUILD PROMPT section 19.3 requires strict TypeScript in CI.
       The Angular scaffold enables several strict-family flags but not
       `strict` itself, which leaves strictNullChecks off — the single most
       valuable one for a codebase consuming generated API types. */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    /* The API contract is generated from the OpenAPI spec and lives outside
       this app, so it is imported by alias rather than copied. A copy would
       drift, and the CI contract gate only checks packages/contracts. */
    "paths": {
      "@contracts/api": ["../../packages/contracts/api.d.ts"]
    },
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    /* Type-checks expressions inside component templates. Without it, a
       renamed field on an API type fails silently at runtime instead of
       failing the build. */
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
